# ============================================================================
# LEMORA — Variables de entorno (.env.example)
# ============================================================================
# 1) Copiá este archivo a `.env.local`
# 2) Completá con los valores de tu proyecto en https://supabase.com/dashboard
# 3) Ejecutá `npm run build:env` para generar js/env.generated.js
#
# En Vercel: agregá estas mismas variables en Project Settings → Environment
# Variables. `vercel env pull` también las descarga a .env.local.

# URL del proyecto Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anon/publishable (SEGURA para el navegador, es pública)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Service role key — SOLO USADA EN EL SERVIDOR (api/pedido.js en Vercel).
# NUNCA debe llegar al navegador, al repositorio ni a HTML/JS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Dominio público del cliente (SIN https:// y SIN barra final).
# El build la usa para reemplazar el placeholder TU-DOMINIO.com en los 8 HTML
# raíz y en robots.txt, y para generar sitemap.xml. Sin ella, el sitio se
# despliega con el placeholder (modo plantilla) — nunca con un dominio ajeno.
SITIO_URL=tienda.cliente.com

# Orígenes permitidos para la API (api/_lib/origenes.js): el o los dominios
# del cliente separados por coma. Sin esta variable, se acepta el origen
# propio y cualquier *.vercel.app (menos seguro). Ver doc al inicio de
# api/_lib/origenes.js.
ALLOWED_ORIGINS=https://tienda.cliente.com